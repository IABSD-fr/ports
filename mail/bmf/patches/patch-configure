--- configure.orig	Mon Feb 27 19:23:18 2017
+++ configure	Mon Feb 27 19:23:50 2017
@@ -149,13 +149,13 @@ case "$UNAME_S" in
       CCDBG="-DNDEBUG"
       LDDBG=""
     fi
-    CC=gcc
+    CC=cc
     CFLAGS="$CCDBG -D_UNIX -D_BSD=$OSVER -Wall"
-    CXX=g++
+    CXX=c++
     CXXFLAGS=${CFLAGS}
     AR=ar
     ARFLAGS="-rc"
-    LD=gcc
+    LD=cc
     LDFLAGS="$LDDBG"
     SYSLIBS=""
     LIBDB_LIB=""
@@ -162,5 +162,27 @@ case "$UNAME_S" in
     MYSQL_LIB="-lmysqlclient"
     ;;
+  IABSD)
+    # IABSD is an OpenBSD fork, same as OpenBSD
+    OSVER=40
+    if [ "$with_debug" = "yes" ]; then
+      CCDBG="-g"
+      LDDBG="-g"
+    else
+      CCDBG="-DNDEBUG"
+      LDDBG=""
+    fi
+    CC=cc
+    CFLAGS="$CCDBG -D_UNIX -D_BSD=$OSVER -Wall"
+    CXX=c++
+    CXXFLAGS=${CFLAGS}
+    AR=ar
+    ARFLAGS="-rc"
+    LD=cc
+    LDFLAGS="$LDDBG"
+    SYSLIBS=""
+    LIBDB_LIB=""
+    MYSQL_LIB="-lmysqlclient"
+    ;;
   Darwin)
     # I'm guessing Darwin looks mostly like FreeBSD 4.x
     OSVER=40
